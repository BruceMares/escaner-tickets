# Copia este archivo como ".env" (en esta misma carpeta /app) y pon tus llaves reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# IA — llave gratis en https://aistudio.google.com (botón "Get API key").
EXPO_PUBLIC_GEMINI_API_KEY=

# Login y base de datos — Supabase → Project Settings → API (ver docs/configurar-login.md).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Fotos de los tickets — Cloudinary (Cloud name + upload preset "Unsigned").
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
